# Stock Expert AI - Environment Variables

# --- LLM Roles -------------------------------------------------------------
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001

# Embedding provider
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/gemini-embedding-001

# Keyword extraction provider
KEYWORD_LLM_PROVIDER=anthropic
KEYWORD_LLM_MODEL=claude-haiku-4-5-20251001
# ---------------------------------------------------------------------------

# Gemini API Key
GEMINI_API_KEY=your-gemini-api-key

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key

# Groq API Key
GROQ_API_KEY=your-groq-api-key

# Anthropic API Key
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Naver Open API (KR news search) ----------------------------------------
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
# ----------------------------------------------------------------------------

# --- KRX (한국거래소) credentials ----------------------------------------------
KRX_ID=
KRX_PW=
# ----------------------------------------------------------------------------

# --- Scheduler / Telegram digest --------------------------------------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Comma-separated tickers to analyze every run.
SCHEDULER_WATCHLIST=005930.KS,000660.KS,035420.KS

# Run schedule (default: 12:00 Asia/Seoul → noon KST).
SCHEDULER_RUN_HOUR=12
SCHEDULER_RUN_MINUTE=0
SCHEDULER_TIMEZONE=Asia/Seoul
# ----------------------------------------------------------------------------
