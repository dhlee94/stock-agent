# Stock Expert AI - Environment Variables

# --- LLM Roles -------------------------------------------------------------
# You can mix-and-match providers across the three roles below.
#
# Main reasoning LLM (Planner / Executor / Reflector / Summarizer)
# Provider options: "gemini", "openai", "groq", "anthropic"
LLM_PROVIDER=anthropic
# Optional model override. Leave unset to use the per-provider default.
#   gemini    → gemini-2.0-flash
#   openai    → gpt-4o
#   groq      → llama-3.3-70b-versatile
#   anthropic → claude-sonnet-4-6   (also try: claude-haiku-4-5-20251001, claude-opus-4-7)
LLM_MODEL=claude-haiku-4-5-20251001

# Embedding provider (episodic + semantic memory similarity search)
# Options: "gemini" (default, free), "openai"
# Note: Anthropic does not provide embeddings; if you pick "anthropic" above,
# embeddings still go through Gemini or OpenAI.
EMBEDDING_PROVIDER=anthropic
# Optional model override. Defaults:
#   gemini → models/text-embedding-004
#   openai → text-embedding-3-small
EMBEDDING_MODEL=claude-haiku-4-5-20251001

# Keyword extraction provider (DriverMemory historical-driver mining)
# Options: "gemini", "openai", "groq", "anthropic"
# Defaults to LLM_PROVIDER if unset.
KEYWORD_LLM_PROVIDER=anthropic
# Optional model override. Per-provider defaults (smaller/cheaper than main):
#   gemini    → gemini-2.0-flash
#   openai    → gpt-4o-mini
#   groq      → llama-3.3-70b-versatile
#   anthropic → claude-haiku-4-5-20251001
KEYWORD_LLM_MODEL=claude-haiku-4-5-20251001
# ---------------------------------------------------------------------------

# Gemini API Key (free tier available)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# OpenAI API Key (paid)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Groq API Key (free tier, fast Llama 3.3 70B)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Anthropic API Key (Claude Sonnet 4.6)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Naver Open API (KR news search) ----------------------------------------
# Free tier: 25,000 requests / day / app. Used for Korean news coverage in
# src/tools/stock/news_naver.py — when keys are missing the code falls back
# to other news sources.
#
# 1) Go to https://developers.naver.com/apps/#/register
# 2) "사용 API" → select "검색" (the 뉴스 endpoint lives inside this group;
#    do NOT pick Papago / 지도 / 캡차 / etc.)
# 3) "환경 추가" → WEB 설정, 사용 URL은 http://localhost 로 두면 됩니다.
# 4) 등록 후 발급된 Client ID / Client Secret 을 아래에 붙여넣으세요.
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
# ----------------------------------------------------------------------------

# --- Scheduler / Telegram digest --------------------------------------------
# Used by `src/scheduler/main.py` (the daily Telegram digest container).
#
# 1) Create a bot via @BotFather on Telegram → copy the token below.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# 2) Send any message to your bot, then visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy the chat.id field.
TELEGRAM_CHAT_ID=your-telegram-chat-id

# --- Forecasting Models -----------------------------------------------------
# Moirai 2.0 — primary forecaster (Salesforce, CC-BY-NC-4.0 — research/non-commercial only)
MOIRAI_ENABLED=true
# Model size options: moirai-2.0-R-small | moirai-2.0-R-base | moirai-2.0-R-large
MOIRAI_MODEL=Salesforce/moirai-2.0-R-small

# Chronos-2 — secondary signal (Amazon, Apache 2.0 — commercial OK), off by default
CHRONOS_ENABLED=false
# v2 multivariate (default): amazon/chronos-2
# v1 legacy univariate:      amazon/chronos-bolt-small | amazon/chronos-t5-small
CHRONOS_MODEL=amazon/chronos-2
# ----------------------------------------------------------------------------

# Comma-separated tickers to analyze every run.
SCHEDULER_WATCHLIST=005930.KS,000660.KS,035420.KS

# Run schedule (default: 12:00 Asia/Seoul → noon KST).
SCHEDULER_RUN_HOUR=12
SCHEDULER_RUN_MINUTE=0
SCHEDULER_TIMEZONE=Asia/Seoul
# ----------------------------------------------------------------------------